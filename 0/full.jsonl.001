 ? [Number(box[1]), Number(box[2])] : [1, 1];","+  const long = Math.max(w, h) || 1;","+  const size = `width=\"${Math.round((px * w) / long)}\" height=\"${Math.round((px * h) / long)}\"`;","+  const bare = tag.replace(/\\s(width|height)\\s*=\\s*(\"[^\"]*\"|'[^']*')/g, \"\");","+  return text.slice(0, root.index) + bare.replace(/^<svg/, `<svg ${size}`) + text.slice(root.index + tag.length);","+}","+","+const WRITE_TEXT = 'out=$1; [ -s \"$out\" ] && exit 0; printf %s \"$2\" > \"$out.part\" && mv -f \"$out.part\" \"$out\"';","+","+/** An SVG at `rev`, written resized so it is drawn sharp; null to fall back to the file as it is. */","+async function writeSvg(git: Git, exec: Exec, target: Target, rev: string, path: string, cache: { abs: string; rel: string }): Promise<{ path: string | null; note: string | null } | null> {","+  const id = await blobId(git, target, rev, path);","+  if (id === null || target.on !== null) return null;","+  try {","+    const size = Number((await git(target, [\"cat-file\", \"-s\", id])).trim());","+    if (!(size <= MAX_SIZED_SVG)) return null;","+    const text = sizedSvg(await git(target, [\"cat-file\", \"blob\", id]), SVG_PX);","+    await exec(\"mkdir\", [\"-p\", cache.abs], {});","+    const r = await exec(\"sh\", [\"-c\", WRITE_TEXT, \"sh\", `${cache.abs}/${id}.big.svg`, text], { cwd: target.cwd });","+    if (r.code !== 0) return { path: null, note: r.stderr.split(\"\\n\")[0] || `Couldn't write the image (${r.code})` };","+    return { path: `${cache.rel}/${id}.big.svg`, note: null };","+  } catch {","+    return null;","+  }","+}","+"," /** One commit's image, for the viewer tab: `path` for `image()`, or a note on why it can't be drawn. null when the file isn't an image. */"," export async function loadImageAt(git: Git, exec: Exec, target: Target, rev: string, path: string, cache: { abs: string; rel: string }): Promise<{ path: string | null; note: string | null } | null> {","   const ext = pictureExt(path);","   if (ext === null) return null;","+  if (ext === \"svg\") {","+    const sized = await writeSvg(git, exec, target, rev, path, cache);","+    if (sized) return sized;","+  }","   const pair = await writePair(git, exec, target, { hash: rev, parents: [], path, oldPath: null }, ext, cache);","   if (pair.note !== null || pair.new !== null) return { path: pair.new, note: pair.note };","   return { path: null, note: `${path} is not in ${rev.slice(0, 10)}` };"]}]},{"filePath":"/Volumes/WorkSpace/vogle/herdr-gitdeck/src/ui/fileBody.ts","hunks":[{"oldStart":75,"oldLines":9,"newStart":75,"newLines":8,"lines":[" "," /** The light card an SVG is drawn on: icons draw their lines in black (currentColor), unseen on a dark tab. */"," const CARD = \"#f4f4f5\";","-const VECTOR_MAX = 520;"," ","-/** An SVG scaled up to fill a light card (a vector stays sharp), so a 24 px icon is seen whole. */","+/** An SVG fitted to the tab on a light card, its shape kept: it is written large, so it stays sharp. */"," function vectorBody(picture: Picture, p: Palette): Element {","   if (picture.path === null) return div().p(12).text_color(p.dim).child(picture.note ?? \"No picture\");","   return v_flex()"]},{"oldStart":90,"oldLines":8,"newStart":89,"newLines":6,"lines":["       div()","         .w_full()","         .h_full()","-        .max_w(VECTOR_MAX)","-        .max_h(VECTOR_MAX)","         .p(32)","         .rounded(8)","         .bg(CARD)"]}]}],"moreFiles":0,"changedFiles":["/Volumes/WorkSpace/vogle/herdr-gitdeck/src/core/imageDiff.ts","/Volumes/WorkSpace/vogle/herdr-gitdeck/src/ui/fileBody.ts"]}},"sandboxed":false,"sourceToolAssistantUUID":"4f40cdc8-8838-41b1-aee2-32950f26a73b","permissionDecision":{"decision":"accept","source":"hook","reasonType":"hook"},"session_id":"c36cb7dc-d64c-445a-9a8d-ccb9a1219a29","userType":"external","entrypoint":"cli","cwd":"/Volumes/WorkSpace/vogle/herdr-gitdeck","sessionId":"c36cb7dc-d64c-445a-9a8d-ccb9a1219a29","version":"2.1.325","gitBranch":"feat/agent-centered-panel","slug":"nifty