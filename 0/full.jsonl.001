Element {')\nend=s.index('/** The commit pane\\'s File Tree tab')\ns=s[:start]+s[end:]\nopen('src/ui/treePane.ts','w').write(s)\nedit('src/ui/treePane.ts',[\n ('''// the kind's icon, the name, and here the size at the end. A click on a file\n// shows its content at the commit in the same pane.''','''// the kind's icon, the name, and here the size at the end. A click on a file\n// opens it, as it is at the commit, in the viewer tab.'''),\n ('import { FILE_ICONS, ICONS, icon, monoFont, textButton, type Palette } from \"./style.ts\";','import { FILE_ICONS, ICONS, icon, textButton, type Palette } from \"./style.ts\";'),\n ('const ROW = 24;\\nconst LINE = 18;','const ROW = 24;'),\n ('''  /** Opens a file (its place in the tree's list), or with null goes back to the tree. */\n  file: (index: number | null, cx: Context) => void;''','''  /** Opens a file (its place in the tree's list) in the viewer tab. */\n  file: (index: number, cx: Context) => void;'''),\n ('''/** The commit pane's File Tree tab: the tree, or one file of it. */\nexport function treePane(v: TreeView, p: Palette, a: TreeActions): Element {\n  const file = v.file;\n  const crumb = file\n    ? [textButton(\"tree-back\", \"← Files\", p, (cx) => a.file(null, cx)), div().flex_1().min_w_0().truncate().text_xs().text_color(p.dim).child(file.path)]\n    : [div().flex_1()];\n''','''/** The commit pane's File Tree tab. */\nexport function treePane(v: TreeView, p: Palette, a: TreeActions): Element {\n'''),\n ('        ...crumb,\\n','        div().flex_1(),\\n'),\n ('    .child(file ? content(v, p) : folders(v, p, a));','    .child(folders(v, p, a));'),\n])\n\n# 3. The tree's state: which folders are open; no file or content of its own.\nedit('src/core/inspect.ts',[\n ('| { kind: \"tree\"; rev: string; data: Loaded<TreeFile> | null; file: TreeFile | null; blob: BlobView | null; open: ReadonlySet<string> };',\n  '| { kind: \"tree\"; rev: string; data: Loaded<TreeFile> | null; open: ReadonlySet<string> };'),\n ('import 