st found: Record<string, string> = {};\n  for (const w of wanted) {\n    const args = [\"api\", `avatar?email=${encodeURIComponent(normal(w.email))}&size=${SIZE}`, \"--hostname\", source.host];\n    const r = await exec(\"glab\", args, { cwd: away, on: target.on }).catch(() => null);\n    const url = r && r.code === 0 ? parseGitlabAvatar(r.stdout) : null;\n    if (url) found[normal(w.email)] = url;\n  }\nsrc/avatars.ts:10:import { readAvatarSource } from \"./core/forge/index.ts\";\nsrc/avatars.ts-11-import type { Commit } from \"./core/git/log.ts\";\nsrc/avatars.ts-12-import type { Git, Target } from \"./core/git/runner.ts\";\nsrc/avatars.ts-13-\nsrc/avatars.ts-14-/** Where the pictures are, as `image()` takes it (from Herdr's own folder). */\nsrc/avatars.ts-15-const SHOWN_DIR = \"mods/gitdeck/.avatars\";\nsrc/avatars.ts-16-/** At most this many new authors are looked up per history read. */\nsrc/avatars.ts-17-const MAX_NEW = 60;\nsrc/avatars.ts-18-\nsrc/avatars.ts-19-export class Avatars {\nsrc/avatars.ts-20-  /** base name (a hash of the email) → saved file. */\nsrc/avatars.ts-21-  private files: Readonly<Record<string, string>> = {};\nsrc/avatars.ts-22-  /** Authors already looked up this session, found or not: not asked again. */\nsrc/avatars.ts-23-  private asked: ReadonlySet<string> = new Set();\nsrc/avatars.ts-24-  private listed = false;\nsrc/avatars.ts-25-  private busy = false;\nsrc/avatars.ts-26-\nsrc/avatars.ts-27-  /** The picture to draw for an email, once it is saved; null keeps the initials. */\nsrc/avatars.ts-28-  path(email: string): string | null {\nsrc/avatars.ts-29-    const file = this.files[avatarBase(email)];\nsrc/avatars.ts-30-    return file ? `${SHOWN_DIR}/${file}` : null;\nsrc/avatars.ts-31-  }\nsrc/avatars.ts-32-\nsrc/avatars.ts-33-  private dir(): string {\nsrc/avatars.ts-34-    return `${home()}/.config/herdr-app/${SHOWN_DIR}`;\nsrc/avatars.ts-35-  }\nsrc/avatars.ts:74:      const source = await readAvatarSource(git, target);\nsrc/avat