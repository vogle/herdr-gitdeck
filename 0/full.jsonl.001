pen folder shows its folders, then its files, one step in\", () => {","+  assert.deepEqual(show(treeRows(files, new Set([\"src/\"]))), [\"> docs/deep/ 1\", \"v src/ 3\", \"  > ui/ 2\", \"  a.ts #2\", \".gitignore #0\", \"README.md #1\"]);","+  assert.deepEqual(show(treeRows(files, new Set([\"src/\", \"src/ui/\"]))).slice(2, 5), [\"  v ui/ 2\", \"    b.ts #3\", \"    c.ts #4\"]);","+});","+","+test(\"a folder inside a folded one stays hidden, even when it is open\", () => {","+  assert.equal(show(treeRows(files, new Set([\"src/ui/\"]))).some((r) => r.includes(\"b.ts\")), false);","+});","+","+test(\"toggleFolder opens a folded folder and folds an open one, as a new set\", () => {","+  const open = new Set([\"src/\"]);","+  const next = toggleFolder(open, \"docs/deep/\");","+  assert.deepEqual([...next].sort(), [\"docs/deep/\", \"src/\"]);","+  assert.deepEqual([...toggleFolder(next, \"src/\")], [\"docs/deep/\"]);","+  assert.deepEqual([...open], [\"src/\"], \"the old set is left as it was\");","+});","+","+test(\"sizeText reads like a file browser\", () => {","+  assert.equal(sizeText(0), \"0 B\");","+  assert.equal(sizeText(1023), \"1023 B\");","+  assert.equal(sizeText(8656), \"8.5 KB\");","+  assert.equal(sizeText(1536 * 1024), \"1.5 MB\");","+  assert.equal(sizeText(200 * 1024), \"200 KB\");","+});"]}],"created":true}],"moreFiles":0,"changedFiles":["/Volumes/WorkSpace/vogle/herdr-gitdeck/tests/treeRows.test.ts"]}},"sandboxed":false,"sourceToolAssistantUUID":"ed559961-71f9-4df0-b0a4-37f9b0883b7a","permissionDecision":{"decision":"accept","source":"hook","reasonType":"hook"},"session_id":"c36cb7dc-d64c-445a-9a8d-ccb9a1219a29","userType":"external","entrypoint":"cli","cwd":"/Volumes/WorkSpace/vogle/herdr-gitdeck","sessionId":"c36cb7dc-d64c-445a-9a8d-ccb9a1219a29","version":"2.1.325","gitBranch":"feat/agent-centered-panel","slug":"nifty-leaping-sketch"}
