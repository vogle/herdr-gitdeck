      .gap(12)","+            .items_center()","+            .whitespace_nowrap()","+            .child(div().w(44).flex_shrink_0().text_right().text_color(p.dim).child(String(range.start + i + 1)))","+            .child(div().flex_1().min_w_0().truncate().child(text === \"\" ? \" \" : text)),","+        ),","+      ).size_full(),","+    )","+    .child(Scrollbar.vertical(LIST).absolute().inset_0());","+}"]}],"created":true},{"filePath":"/Volumes/WorkSpace/vogle/herdr-gitdeck/src/ui/historyPane.ts","hunks":[{"oldStart":30,"oldLines":7,"newStart":30,"newLines":8,"lines":["   closeInspect: (cx: Context) => void;","   /** Takes the repo as it is now as seen: the new-file dots and counts clear. */","   markSeen: (cx: Context) => void;","-  treeFile: (index: number | null, cx: Context) => void;","+  /** Opens a File Tree file in the viewer tab. */","+  treeFile: (index: number, cx: Context) => void;","   /** Opens or folds a folder of the File Tree tab. */","   toggleTreeFolder: (folder: string, cx: Context) => void;","   setForge: (kind: ForgeChoice, cx: Context) => void;"]}]},{"filePath":"/Volumes/WorkSpace/vogle/herdr-gitdeck/src/ui/treePane.ts","hunks":[{"oldStart":1,"oldLines":7,"newStart":1,"newLines":7,"lines":[" // A commit's files as a folder tree, in the commit pane under the History list"," // (Fork's File Tree tab). Rows are drawn as the Changes tab draws its files:"," // the kind's icon, the name, and here the size at the end. A click on a file","-// shows its content at the commit in the same pane.","+// opens it, as it is at the commit, in the viewer tab."," "," import { div, type Context, type Element } from \"gpui-kit\";"," import { h_flex, v_flex, v_virtual_list, Scrollbar } from \"gpui-base\";"]},{"oldStart":9,"oldLines":11,"newStart":9,"newLines":10,"lines":[" import type { InspectView } from \"../core/inspect.ts\";"," import { sizeText, treeRows, type TreeRow } from \"../core/treeRows.ts\";"," import { tabBar } from \"./details.ts\";","-import { FILE