rl as string) : null;\n107\t  } catch {\n108\t    return null;\n109\t  }\n110\t}\n111\t\n112\tasync function githubUrls(exec: Exec, target: Target, away: string, source: AvatarSource, wanted: readonly AvatarWanted[]): Promise<Record<string, string>> {\n113\t  const [owner = \"\", name = \"\"] = source.path.split(\"/\");\n114\t  const found: Record<string, string> = {};\n115\t  for (let i = 0; i < wanted.length; i += BATCH) {\n116\t    const batch = wanted.slice(i, i + BATCH);\n117\t    try {\n118\t      const query = githubQuery(owner, name, batch.map((w) => w.hash));\n119\t      const r = await exec(\"gh\", [\"api\", \"graphql\", \"--hostname\", source.host, \"-f\", `query=${query}`], { cwd: away, on: target.on });\n120\t      // Some commits not on GitHub still answer the rest.\n121\t      Object.assign(found, parseGithubAvatars(r.stdout));\n122\t    } catch {\n123\t      return found;\n124\t    }\n125\t  }\n126\t  return found;\n127\t}\n128\t\n129\tasync function gitlabUrls(exec: Exec, target: Target, away: string, source: AvatarSource, wanted: readonly AvatarWanted[]): Promise<Record<string, string>> {\n130\t  const found: Record<string, string> = {};\n131\t  for (const w of wanted) {\n132\t    const args = [\"api\", `avatar?email=${encodeURIComponent(normal(w.email))}&size=${SIZE}`, \"--hostname\", source.host];\n133\t    const r = await exec(\"glab\", args, { cwd: away, on: target.on }).catch(() => null);\n134\t    const url = r && r.code === 0 ? parseGitlabAvatar(r.stdout) : null;\n135\t    if (url) found[normal(w.email)] = url;\n136\t  }\n137\t  return found;\n138\t}\n139\t\n140\t/**\n141\t * email → picture URL for the authors the forge knows; the rest are left out\n142\t * (the graph keeps their initials). The CLIs run outside the repo, in `away`.\n143\t */\n144\texport async function findAvatarUrls(\n145\t  exec: Exec,\n146\t  target: Target,\n147\t  away: string,\n148\t  source: AvatarSource,\n149\t  wanted: readonly AvatarWanted[],\n150\t): Promise<Readonly<Record<string, string>>> {\n151\t  const known: Record<string, string> = {};\n152\t  const ask: AvatarWanted[] = [];\n153\t  for (const w of wanted) {\n154\t    const url = source.kind === \"github\" ? noreplyAvatar(w.email) : null;\n155\t    if (url) known[w.email] = url;\n156\t    else ask.push(w);\n157\t  }\n158\t  if (ask.length === 0) return known;\n159\t  const asked = source.kind === \"github\" ? await githubUrls(exec, target, away, source, ask) : await gitlabUrls(exec, target, away, source, ask);\n160\t  for (const w of ask) {\n161\t    const url = asked[normal(w.email)];\n162\t    if (url) known[w.email] = url;\n163\t  }\n164\t  return known;\n165\t}\n166\t\n167\t/**\n168\t * Saves the picture at `url` as `<dir>/<base>.<ext>` and returns that file name;\n169\t * null when it isn't an image (a sign-in page, an error). It is written to a\n170\t * `.tmp` first and renamed, so the graph never finds half a file.\n171\t */\n172\texport async function downloadAvatar(exec: Exec, dir: string, url: string, base: string): Promise<string | null> {\n173\t  if (!url.startsWith(\"https://\")) return null;\n174\t  const tmp = `${dir}/${base}.tmp`;\n175\t  try {\n176\t    const r = await exec(\"curl\", [\"-fsSL\", \"--proto\", \"=https\", \"--proto-redir\", \"=https\", \"--max-time\", \"15\", \"--max-filesize\", \"2000000\", \"-o\", tmp, \"-w\", \"%{content_type}\", \"--\", url], {});\n177\t    const ext = r.code === 0 ? IMAGE_TYPES[r.stdout.split(\";\")[0]?.trim().toLowerCase() ?? \"\"] : undefined;\n178\t    if (!ext) {\n179\t      await exec(\"rm\", [\"-f\", tmp], {});\n180\t      return null;\n181\t    }\n182\t    const file = `${base}.${ext}`;\n183\t    const moved = await exec(\"mv\", [\"-f\", tmp, `${dir}/${file}`], {});\n184\t    return moved.code === 0 ? file : null;\n185\t  } catch {\n186\t    return null;\n187\t  }\n188\t}\n189\t\n</system-reminder>"}],"renderedRole":"user","userType":"external","entrypoint":"cli","cwd":"/Volumes/WorkSpace/vogle/herdr-gitdeck","sessionId":"c36cb7dc-d64c-445a-9a8d-ccb9a1219a29","version":"2.1.325","gitBranch":"feat/agent-centered-panel","slug":"nifty-leaping-sketch"}
{"parentUuid":"87822313-dc2e-4ff7-8e0c-0fbd60c70540","isSidechain":false,"attachment":{"type":"file","filename":"/Volumes/WorkSpace/vogle/herdr-gitdeck/tests/avatars.test.ts","content":{"type":"text","file":{"filePath":"/Volumes/WorkSpace/vogle/herdr-gitdeck/tests/avatars.test.ts","content":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport type { Exec, ExecResult } from \"../src/core/git/runner.ts\";\nimport {\n  avatarBase, downloadAvatar, findAvatarUrls, githubQuery, knownAvatars, noreplyAvatar, parseGithubAvatars, parseGitlabAvatar,\n  type AvatarSource,\n} from \"../src/core/avatars.ts\";\n\nconst T = { cwd: \"/r\", on: null };\nconst ok = (stdout: string): ExecResult => ({ code: 0, stdout, stderr: \"\" });\n\ntest(\"an avatar's file name is a hash of the email, never the email itself\", () => {\n  const a = avatarBase(\"Ada@Example.com\");\n  assert.match(a, /^[0-9a-f]{16}$/);\n  assert.equal(a, avatarBase(\" ada@example.com \"), \"case and spaces don't matter\");\n  assert.notEqual(a, avatarBase(\"bob@example.com\"));\n  assert.ok(!a.includes(\"example\"));\n});\n\ntest(\"a GitHub noreply email names its account, so its picture needs no lookup\", () => {\n  assert.equal(noreplyAvatar(\"123+ada@users.noreply.github.com\"), \"https://avatars.githubusercontent.com/u/123?s=64\");\n  assert.equal(noreplyAvatar(\"ada@users.noreply.github.com\"), null, \"the old form has no id\");\n  assert.equal(noreplyAvatar(\"ada@example.com\"), null);\n});\n\ntest(\"knownAvatars reads the saved files back as base name to file\", () => {\n  assert.deepEqual(knownAvatars([\"0123456789abcdef.png\", \"fedcba9876543210.jpg\", \"x.tmp\", \"notes.txt\", \"0123456789abcdef.tmp\"]), {\n    \"0123456789abcdef\": \"0123456789abcdef.png\",\n    fedcba9876543210: \"fedcba9876543210.jpg\",\n  });\n});\n\ntest(\"one GitHub query asks for many commits' authors by alias\", () => {\n  const q = githubQuery(\"vogle\", \"gitdeck\", [\"aaa111\", \"bbb222\"]);\n  assert.match(q, /repository\\(owner: \"vogle\", name: \"gitdeck\"\\)/);\n  assert.match(q, /c0: object\\(oid: \"aaa111\"\\)/);\n  assert.match(q, /c1: object\\(oid: \"bbb222\"\\)/);\n  assert.match(q, /avatarUrl\\(size: 64\\)/);\n  assert.throws(() => githubQuery(\"a\\\"b\", \"c\", [\"aaa\"]), \"a name that could break the query is refused\");\n  assert.throws(() => githubQuery(\"a\", \"c\", [\"not-a-hash\"]));\n});\n\ntest(\"parseGithubAvatars maps each commit's email to its user's picture; unpushed or unknown ones are left out\", () => {\n  const out = JSON.stringify({\n    data: {\n      repository: {\n        c0: { author: { email: \"ada@x.io\", user: { avatarUrl: \"https://avatars.githubusercontent.com/u/1?s=64\" } } },\n        c1: { author: { email: \"bob@x.io\", user: null } },\n        c2: null,\n      },\n    },\n  });\n  assert.deepEqual(parseGithubAvatars(out), { \"ada@x.io\": \"https://avatars.githubusercontent.com/u/1?s=64\" });\n  assert.deepEqual(parseGithubAvatars(\"not json\"), {});\n});\n\ntest(\"parseGitlabAvatar keeps the server's own picture and refuses Gravatar\", () => {\n  assert.equal(parseGitlabAvatar('{\"avatar_url\":\"https://git.acme.dev/uploads/-/system/user/avatar/4/a.png\"}'), \"https://git.acme.dev/uploads/-/system/user/avatar/4/a.png\");\n  assert.equal(parseGitlabAvatar('{\"avatar_url\":\"https://secure.gravatar.com/avatar/abc?s=64\"}'), null);\n  assert.equal(parseGitlabAvatar('{\"avatar_url\":\"https://www.gravatar.com/avatar/abc\"}'), null);\n  assert.equal(parseGitlabAvatar('{\"avatar_url\":null}'), null);\n  assert.equal(parseGitlabAvatar(\"<html>\"), null);\n});\n\ntest(\"findAvatarUrls asks GitHub once per batch of commits, outside the repo, and skips noreply emails\", async () => {\n  const calls: [string, string[], unknown][] = [];\n  const exec: Exec = async (c, a, o) => {\n    calls.push([c, a, o]);\n    return ok(JSON.stringify({ data: { repository: { c0: { author: { email: \"ada@x.io\", user: { avatarUrl: \"https://a/1\" } } } } } }));\n  };\n  const source: AvatarSource = { kind: \"github\", host: \"github.com\", path: \"vogle/gitdeck\" };\n  const urls = await findAvatarUrls(exec, T, \"/home\", source, [\n    { email: \"ada@x.io\", hash: \"aaa111\" },\n    { email: \"9+bob@users.noreply.github.com\", hash: \"bbb222\" },\n  ]);\n  assert.deepEqual(urls, { \"ada@x.io\": \"https://a/1\", \"9+bob@users.noreply.github.com\": \"https://avatars.githubusercontent.com/u/9?s=64\" });\n  assert.equal(calls.length, 1);\n  assert.equal(calls[0]?.[0], \"gh\");\n  assert.deepEqual(calls[0]?.[1].slice(0, 4), [\"api\", \"graphql\", \"--hostname\", \"github.com\"]);\n  assert.deepEqual(calls[0]?.[2], { cwd: \"/home\", on: null });\n});\n\ntest(\"findAvatarUrls asks a GitLab server once per email; a failure leaves that email out\", async () => {\n  const calls: string[][] = [];\n  const exec: Exec = async (c, a) => {\n    calls.push([c, ...a]);\n    if (a[1]?.includes(\"ada\")) return ok('{\"avatar_url\":\"https://git.acme.dev/uploads/a.png\"}');\n    return { code: 1, stdout: \"\", stderr: \"404\" };\n  };\n  const source: AvatarSource = { kind: \"gitlab\", host: \"git.acme.dev\", path: \"g/app\" };\n  const urls = await findAvatarUrls(exec, T, \"/home\", source, [\n    { email: \"ada@x.io\", hash: \"aaa111\" },\n    { email: \"bob@x.io\", hash: \"bbb222\" },\n  ]);\n  assert.deepEqual(urls, { \"ada@x.io\": \"https://git.acme.dev/uploads/a.png\" });\n  assert.deepEqual(calls[0], [\"glab\", \"api\", \"avatar?email=ada%40x.io&size=64\", \"--hostname\", \"git.acme.dev\"]);\n  assert.equal(calls.length, 2);\n});\n\ntest(\"downloadAvatar keeps only an image, under its final name once it is whole\", async () => {\n  const calls: string[][] = [];\n  const run = (contentType: string, code = 0): Exec => async (c, a) => {\n    calls.push([c, ...a]);\n    return c === \"curl\" ? { code, stdout: contentType, stderr: \"\" } : ok(\"\");\n  };\n  assert.equal(await downloadAvatar(run(\"image/png\"), \"/d\", \"https://a/1\", \"abc\"), \"abc.png\");\n  assert.deepEqual(calls[0]?.slice(0, 2), [\"curl\", \"-fsSL\"]);\n  assert.ok(calls[0]?.includes(\"/d/abc.tmp\"));\n  assert.deepEqual(calls[1], [\"mv\", \"-f\", \"/d/abc.tmp\", \"/d/abc.png\"]);\n  calls.length = 0;\n  assert.equal(await downloadAvatar(run(\"image/jpeg; charset=binary\"), \"/d\", \"https://a/1\", \"abc\"), \"abc.jpg\");\n  calls.length = 0;\n  assert.equal(await downloadAvatar(run(\"text/html\"), \"/d\", \"https://a/1\", \"abc\"), null, \"a sign-in page is not a picture\");\n  assert.deepEqual(calls[1], [\"rm\", \"-f\", \"/d/abc.tmp\"]);\n  calls.length = 0;\n  assert.equal(await downloadAvatar(run(\"\", 22), \"/d\", \"https://a/1\", \"abc\"), null);\n  assert.equal(await downloadAvatar(async () => { throw new Error(\"no curl\"); }, \"/d\", \"https://a/1\", \"abc\"), null);\n  assert.equal(await downloadAvatar(run(\"image/png\"), \"/d\", \"file:///etc/passwd\", \"abc\"), null, \"only https\");\n});\n","numLines":120,"startLine":1,"totalLines":120}},"displayPath":"tests/avatars.test.ts","savedCopyFraming":{"enveloped":false}},"type":"attachment","uuid":"9c952632-7937-4978-9747-4f979fb1a29c","timestamp":"2026-11-19T02:59:48.102Z","rendered":[{"content":"<system-reminder>\nCalled the Read tool with the following input: {\"file_path\":\"/Volumes/WorkSpace/vogle/herdr-gitdeck/tests/avatars.test.ts\"}\n</system-reminder>"},{"content":"<system-reminder>\nResult of calling the Read tool:\n1\timport { test } from \"node:test\";\n2\timport assert from \"node:assert/strict\";\n3\timport type { Exec, ExecResult } from \"../src/core/git/runner.ts\";\n4\timport {\n5\t  avatarBase, downloadAvatar, findAvatarUrls, githubQuery, knownAvatars, noreplyAvatar, parseGithubAvatars, parseGitlabAvatar,\n6\t  type AvatarSource,\n7\t} from \"../src/core/avatars.ts\";\n8\t\n9\tconst T = { cwd: \"/r\", on: null };\n10\tconst ok = (stdout: string): ExecResult => ({ code: 0, stdout, stderr: \"\" });\n11\t\n12\ttest(\"an avatar's file na