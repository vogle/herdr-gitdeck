a@x.io\", user: { avatarUrl: \"https://avatars.githubusercontent.com/u/1?s=64\" } } },\n48\t        c1: { author: { email: \"bob@x.io\", user: null } },\n49\t        c2: null,\n50\t      },\n51\t    },\n52\t  });\n53\t  assert.deepEqual(parseGithubAvatars(out), { \"ada@x.io\": \"https://avatars.githubusercontent.com/u/1?s=64\" });\n54\t  assert.deepEqual(parseGithubAvatars(\"not json\"), {});\n55\t});\n56\t\n57\ttest(\"parseGitlabAvatar keeps the server's own picture and refuses Gravatar\", () => {\n58\t  assert.equal(parseGitlabAvatar('{\"avatar_url\":\"https://git.acme.dev/uploads/-/system/user/avatar/4/a.png\"}'), \"https://git.acme.dev/uploads/-/system/user/avatar/4/a.png\");\n59\t  assert.equal(parseGitlabAvatar('{\"avatar_url\":\"https://secure.gravatar.com/avatar/abc?s=64\"}'), null);\n60\t  assert.equal(parseGitlabAvatar('{\"avatar_url\":\"https://www.gravatar.com/avatar/abc\"}'), null);\n61\t  assert.equal(parseGitlabAvatar('{\"avatar_url\":null}'), null);\n62\t  assert.equal(parseGitlabAvatar(\"<html>\"), null);\n63\t});\n64\t\n65\ttest(\"findAvatarUrls asks GitHub once per batch of commits, outside the repo, and skips noreply emails\", async () => {\n66\t  const calls: [string, string[], unknown][] = [];\n67\t  const exec: Exec = async (c, a, o) => {\n68\t    calls.push([c, a, o]);\n69\t    return ok(JSON.stringify({ data: { repository: { c0: { author: { email: \"ada@x.io\", user: { avatarUrl: \"https://a/1\" } } } } } }));\n70\t  };\n71\t  const source: AvatarSource = { kind: \"github\", host: \"github.com\", path: \"vogle/gitdeck\" };\n72\t  const urls = await findAvatarUrls(exec, T, \"/home\", source, [\n73\t    { email: \"ada@x.io\", hash: \"aaa111\" },\n74\t    { email: \"9+bob@users.noreply.github.com\", hash: \"bbb222\" },\n75\t  ]);\n76\t  assert.deepEqual(urls, { \"ada@x.io\": \"https://a/1\", \"9+bob@users.noreply.github.com\": \"https://avatars.githubusercontent.com/u/9?s=64\" });\n77\t  assert.equal(calls.length, 1);\n78\t  assert.equal(calls[