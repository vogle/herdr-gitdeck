/Volumes/WorkSpace/vogle/herdr-gitdeck/.claude/rules/moai/workflow/context-window-management.md","type":"Project"},{"content":"","path":"/Volumes/WorkSpace/vogle/herdr-gitdeck/.claude/rules/moai/workflow/session-handoff.md","type":"Project"},{"content":"","path":"/Volumes/WorkSpace/vogle/herdr-gitdeck/.claude/rules/moai/workflow/skill-routing.md","type":"Project"},{"content":"","path":"/Volumes/WorkSpace/vogle/herdr-gitdeck/.claude/rules/moai/workflow/goal-directive.md","type":"Project"},{"content":"","path":"/Volumes/WorkSpace/vogle/herdr-gitdeck/.claude/rules/moai/workflow/cross-session-messaging.md","type":"Project"},{"content":"","path":"/Users/allan/.claude/projects/-Volumes-WorkSpace-vogle-herdr-gitdeck/memory/MEMORY.md","type":"AutoMem"}],"type":"instructions"},"cwd":"/Volumes/WorkSpace/vogle/herdr-gitdeck","entrypoint":"cli","gitBranch":"feat/agent-centered-panel","isSidechain":false,"parentUuid":"15067ae8-7532-425b-a4d1-826d2c3692cc","rendered":[{"content":""}],"renderedRole":"user","sessionId":"c36cb7dc-d64c-445a-9a8d-ccb9a1219a29","session_id":"c36cb7dc-d64c-445a-9a8d-ccb9a1219a29","slug":"nifty-leaping-sketch","timestamp":"2026-11-19T04:28:45.593Z","type":"attachment","userType":"external","uuid":"f0127c45-bbf6-41a2-b9d0-6da44bfdd4c2","version":"2.1.325"}
