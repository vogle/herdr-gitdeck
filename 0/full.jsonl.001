ResetMode, cx) => {\nsrc/ops.ts:224:        this.git(cx, \"Resetting\", `Reset to ${sel.hash.slice(0, 10)} (${mode})`, resetArgs(sel.hash, mode));\nsrc/ui/ops.ts:22:  /** Reset: the mode picked after the first click. */\nsrc/ui/ops.ts:60:  \"checkout-commit\": \"Check out\",\nsrc/ui/ops.ts:63:  branch: \"New branch\",\nsrc/ui/ops.ts:65:  \"cherry-pick\": \"Cherry-pick\",\nsrc/ui/ops.ts:66:  revert: \"Revert\",\nsrc/ui/ops.ts:70:  reset: \"Reset to here\",\nsrc/ui/ops.ts:80:  const name = op === \"cherry-pick\" ? \"Cherry-pick\" : op[0]?.toUpperCase() + op.slice(1);\nsrc/ui/ops.ts:138:    .child(div().text_xs().text_color(p.dim).child(kind === \"branch\" ? \"New branch:\" : kind === \"tag\" ? \"New tag:\" : `New ${kind} from ${parts.view.naming?.at ?? \"\"}: ${kind}/`))\nsrc/ui/ops.ts:196:      .child(div().text_xs().text_color(p.dim).child(\"Reset the branch here, keeping:\"))\nsrc/ui/ops.ts:203:  const more = hidden === 0 ? [] : [textButton(\"ca-more\", parts.view.expanded ? \"Less\" : `⋯ ${hidden} more`, p, a.toggleMore)];\nsrc/ui/summary.ts:8:import { entryLetter, fileRow as detailRow, stagedTag } from \"./details.ts\";\nsrc/ui/summary.ts:14:  return detailRow(`sf:${i}`, entryLetter(e), e.path, stagedTag(e, p), p);\nsrc/ui/summary.ts:55:        el.child(div().px(10).py(6).text_xs().text_color(p.dim).child(`… and ${files.length - MAX_FILES} more`)),\nsrc/ui/review.ts:142:  const more = failed.length > SHOWN_CHECKS ? [div().px(10).py(2).text_xs().text_color(p.dim).child(`and ${failed.length - SHOWN_CHECKS} more`)] : [];\nsrc/core/ops.ts:45:export type ResetMode = \"soft\" | \"mixed\" | \"hard\";\nsrc/core/ops.ts:46:export const resetArgs = (hash: string, mode: ResetMode): string[] => [\"reset\", `--${mode}`, hash];","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"sandboxed":false,"sourceToolAssistantUUID":"5409e28c-74af-4128-85be-db6e3beb6837","permissionDecision":{"decision":"accept","source":"hook","reasonType":"hook"},"session_id":"c36