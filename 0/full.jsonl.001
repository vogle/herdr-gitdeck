 ? [","+            ...this.markdownToggle(r, p),","+            textButton(\"viewer-blame\", \"Blame\", p, at(\"blame\")),","+            textButton(\"viewer-history\", \"History\", p, at(\"file-log\")),","+          ]","       : liveDiff(r)","         ? // Read again every few seconds anyway; this is for right now.","           [textButton(\"viewer-reload\", \"Reload\", p, () => this.tick.fire())]"]},{"oldStart":334,"oldLines":6,"newStart":349,"newLines":17,"lines":["     return queueOf(r)?.files.find((f) => f.path === path)?.blob ?? null;","   }"," ","+  /** Rendered or Source, for a markdown file. */","+  private markdownToggle(r: ViewerRequest, p: Palette): Element[] {","+    const s = this.shown;","+    if (r.view !== \"file\" || !isMarkdown(r.path) || s?.kind !== \"file\" || s.blob.note) return [];","+    const show = (rendered: boolean) => (cx: Context) => {","+      if (this.shown === s) this.shown = { ...s, rendered };","+      cx.notify();","+    };","+    return [textButton(\"viewer-rendered\", \"Rendered\", p, show(true), s.rendered), textButton(\"viewer-source\", \"Source\", p, show(false), !s.rendered)];","+  }","+","   /** The find box and how many rows hold what is typed. */","   private findBox(p: Palette): Element {","     const typed = this.find.value().trim() !== \"\";"]},{"oldStart":357,"oldLines":7,"newStart":383,"newLines":7,"lines":["         : s.kind === \"note\"","           ? div().p(12).text_color(p.changed).child(s.text)","           : s.kind === \"file\"","-            ? fileBody(s.blob, p)","+            ? fileBody(s.blob, s.code, s.rendered, p)","           : s.kind === \"diff\"","             ? v_flex()","                 .flex_1()"]}]}],"moreFiles":0,"changedFiles":["/Volumes/WorkSpace/vogle/herdr-gitdeck/src/ui/fileBody.ts","/Volumes/WorkSpace/vogle/herdr-gitdeck/src/viewer.ts"]}},"sandboxed":false,"sourceToolAssistantUUID":"d2bfc799-da6d-4897-a9ff-3e76bdf41b01","permissionDecision":{"decision":"accept","source":"hook","reasonType