{"parentUuid":"968b6ca9-5027-4a6e-b280-f79d648ddab3","isSidechain":false,"promptId":"028832f6-ac65-4611-9b62-8068d7d219e0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QMuJ1ntgf7CKnQ8Re2Eo5c","type":"tool_result","content":"import { test } from \"node:test\";\nimport assert from \"node:assert/strict\";\nimport { GitError, type Git } from \"../src/core/git/runner.ts\";\nimport { loadHistory, loadCommit, loadDiff, searchCommits, withUncommitted, UNCOMMITTED } from \"../src/core/history.ts\";\n\nconst H1 = \"a\".repeat(40);\nconst H2 = \"b\".repeat(40);\nconst T = { cwd: \"/r\", on: null };\n\nconst LOG = `${H1}\\x1f${H2}\\x1fAnn\\x1fann@x.io\\x1f1700000000\\x1fAdd graph\\x1e\\n${H2}\\x1f\\x1fBo\\x1fbo@x.io\\x1f1690000000\\x1fInitial commit\\x1e\\n`;\nconst REFS = `refs/heads/main\\x1f${H1}\\x1f\\x1forigin/main\\x1fahead 1\\x1f*\\nrefs/tags/v0\\x1f${H2}\\x1f\\x1f\\x1f\\x1f `;\nconst STASH = `${H2}\\x1fstash@{0}\\x1fWIP on main\\n`;\n\nfunction fake(answers: Record<string, string | GitError>, calls: string[][] = []): Git {\n  return async (_t, args) => {\n    calls.push(args);\n    const key = args[0] === \"stash\" ? \"stash\" : args[0] ?? \"\";\n    const a = answers[key];\n    if (a instanceof GitError) throw a;\n    return a ?? \"\";\n  };\n}\n\ntest(\"loadHistory reads commits, refs and stashes and lays out lanes\", async () => {\n  const h = await loadHistory(fake({ log: LOG, \"for-each-ref\": REFS, stash: STASH }), T, 500);\n  assert.equal(h.error, null);\n  assert.deepEqual(h.commits.map((c) => c.subject), [\"Add graph\", \"Initial commit\"]);\n  assert.deepEqual(h.lanes.rows.map((r) => r.lane), [0, 0]);\n  assert.deepEqual(h.refs.map((r) => r.name), [\"main\", \"v0\"]);\n  assert.deepEqual(h.byCommit[H1]?.map((r) => r.name), [\"main\"]);\n  assert.deepEqual(h.stashes.map((s) => s.name), [\"stash@{0}\"]);\n  assert.equal(h.limited, false);\n});\n\n * status already read) or the limit. `history` is null when nothing changed.\n */\nexport async function refreshHistory(\n  git: Git,\n  target: Target,\n  limit: number,\n  key: string | null,\n  extra: string,\n): Promise<{ key: string; history: History | null }> {\n  const refsOut = await git(target, [...REFS_ARGS]).catch(() => \"\");\n  const next = `${limit}\\x1e${extra}\\x1e${refsOut}`;\n  if (next === key) return { key, history: null };\n  return { key: next, history: await loadHistory(git, target, limit, refsOut) };\n}\n\n/** The graph row standing for the work tree's changes. */\nexport const UNCOMMITTED = \"*\";\n\nexport function withUncommitted(commits: readonly Commit[], head: string | null, changes: number): readonly Commit[] {\n  if (changes === 0) return commits;\n  const row: Commit = { hash: UNCOMMITTED, parents: head ? [head] : [], author: \"\", email: \"\", time: 0, subject: `Uncommitted changes (${changes})` };\n  return [row, ...commits];\n}\n\nexport interface CommitView {\n  detail: CommitDetail | null;\n  files: readonly CommitFile[];\n  error: string | null;\n}\n\nexport async function loadCommit(git: Git, target: Target, hash: string, parents: readonly string[]): Promise<CommitView> {\n  try {\n    const [header, names, counts] = await Promise.all([\n      git(target, detailArgs(hash)),\n      git(target, filesArgs(hash, parents, \"--name-status\")),\n      git(target, filesArgs(hash, parents, \"--numstat\")),\n    ]);\n    return { detail: parseDetail(header), files: joinFiles(parseNameStatus(names), parseNumstat(counts)), error: null };\n  } catch (error) {\n    return { detail: null, files: [], error: message(error) };\n  }\n}\n\nexport type DiffSource =\n  | { kind: \"commit\"; hash: string; parents: readonly string[]; path: string; oldPath: string | null }\n  | { kind: \"worktree\"; path: string; hasHead: boolean }\n  | { kind: \"untracked\"; path: string }\n  /** One side of an uncommitted file: what is staged, or what is not yet. */\n  | { kind: \"index\"; path: string; staged: boolean };\n\nfunction diffArgs(source: 