;\n112\t  calls.length = 0;\n113\t  assert.equal(await downloadAvatar(run(\"text/html\"), \"/d\", \"https://a/1\", \"abc\"), null, \"a sign-in page is not a picture\");\n114\t  assert.deepEqual(calls[1], [\"rm\", \"-f\", \"/d/abc.tmp\"]);\n115\t  calls.length = 0;\n116\t  assert.equal(await downloadAvatar(run(\"\", 22), \"/d\", \"https://a/1\", \"abc\"), null);\n117\t  assert.equal(await downloadAvatar(async () => { throw new Error(\"no curl\"); }, \"/d\", \"https://a/1\", \"abc\"), null);\n118\t  assert.equal(await downloadAvatar(run(\"image/png\"), \"/d\", \"file:///etc/passwd\", \"abc\"), null, \"only https\");\n119\t});\n120\t\n</system-reminder>"}],"renderedRole":"user","userType":"external","entrypoint":"cli","cwd":"/Volumes/WorkSpace/vogle/herdr-gitdeck","sessionId":"c36cb7dc-d64c-445a-9a8d-ccb9a1219a29","version":"2.1.325","gitBranch":"feat/agent-centered-panel","slug":"nifty-leaping-sketch"}
