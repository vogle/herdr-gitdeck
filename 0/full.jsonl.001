{"parentUuid":"49ce6a03-567c-4359-9bf6-44891c53720c","isSidechain":false,"promptId":"028832f6-ac65-4611-9b62-8068d7d219e0","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CuZsZeuvpZRkAmqLkCGkMb","type":"tool_result","content":"10:/** Runs a program with the user's real environment (HOME, PATH, auth). 8 MiB output.\n12: *  `on`: on that machine (a space's `machine`) through herdr-core, its home by default.\n19:/** The user's home directory. */\n20:export function home(): string;\n21:/** The app's folder (`~/.config/herdr-app`, or `$HERDR_APP_HOME`): settings.json, keys.json, layouts/. */\n22:export function appHome(): string;\n24: *  (exec and writeTextFile included), so guard process side effects. */\n30:/** Writes UTF-8 text only if it still matches expected (null creates a new file).\n32:export function writeTextFile(path: string, text: string, expected: string | null): Promise<null>;\n73: *   terminal.adjust_selection {terminal?, direction: \"left\" | \"right\" | \"up\" | \"down\" | \"page_up\" | \"page_down\" | \"home\" | \"end\" | \"line_start\" | \"line_end\"} (moves the inclusive moving end; view follows; fails without selection).\n83: *   Mod clones rewrite their own asset prefixes and self-opening overlay names.\n126:  /** Its name, or where its first terminal is now (repo, else folder, \"~\" at home)\n131:  /** Where its new terminals start (on its machine; empty: that machine's home). */\n160:  /** A path in the home folder, e.g. \"icons/nvim.svg\". */\n333: *  source (it never updates). `core.managed`: the package manager that owns the core (homebrew,\n472: * Watch what you show, not a whole home folder (node_modules is a lot of events).\nagents         frame-settings  githerd       my-pane  tabs-graph\nchanges        frame-welcome   gitview       pane     toast\nconfirm        gg-e2e-tmp      gitview-diff  prompt   workspace-chrome\nfiles          git-graph       menu          spaces   workspace-status\nframe-palette  gitdeck  