ed;\n    if (!ext) {\n      await exec(\"rm\", [\"-f\", tmp], {});\n      return null;\n    }\n    const file = `${base}.${ext}`;\n    const moved = await exec(\"mv\", [\"-f\", tmp, `${dir}/${file}`], {});\n    return moved.code === 0 ? file : null;\n  } catch {\n    return null;\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"75d97d1b-ab58-4c37-95ed-3c352102d570","permissionDecision":{"decision":"accept","source":"hook","reasonType":"hook"},"session_id":"c36cb7dc-d64c-445a-9a8d-ccb9a1219a29","userType":"external","entrypoint":"cli","cwd":"/Volumes/WorkSpace/vogle/herdr-gitdeck","sessionId":"c36cb7dc-d64c-445a-9a8d-ccb9a1219a29","version":"2.1.325","gitBranch":"feat/agent-centered-panel","slug":"nifty-leaping-sketch"}
