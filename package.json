{
  "name": "herdr-gitdeck",
  "version": "0.1.0",
  "private": true,
  "description": "gitdeck: a git client mod for the Herdr desktop app",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "types": "node scripts/sync-types.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/core/**\" --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 \"tests/**/*.test.ts\"",
    "build": "node scripts/build.mjs",
    "dev": "pnpm build && sh scripts/dev-install.sh",
    "verify": "pnpm typecheck && pnpm coverage && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
